pub async fn add_to_favorites(
    pool: &PgPool,
    user_id: Uuid,
    property_id: Uuid,
) -> Result<()> {
    sqlx::query(
        r#"
        INSERT INTO favorites (user_id, property_id)
        VALUES ($1, $2)
        ON CONFLICT (user_id, property_id) DO NOTHING
        "#,
    )
    .bind(user_id)
    .bind(property_id)
    .execute(pool)
    .await
    .context("Не удалось добавить объект в избранное")?;

    Ok(())
}

pub async fn remove_from_favorites(
    pool: &PgPool,
    user_id: Uuid,
    property_id: Uuid,
) -> Result<()> {
    sqlx::query(
        r#"
        DELETE FROM favorites
        WHERE user_id = $1 AND property_id = $2
        "#,
    )
    .bind(user_id)
    .bind(property_id)
    .execute(pool)
    .await
    .context("Не удалось удалить объект из избранного")?;

    Ok(())
}

pub async fn is_favorite(
    pool: &PgPool,
    user_id: Uuid,
    property_id: Uuid,
) -> Result<bool> {
    let exists = sqlx::query_scalar::<_, bool>(
        r#"
        SELECT EXISTS (
            SELECT 1
            FROM favorites
            WHERE user_id = $1 AND property_id = $2
        )
        "#,
    )
    .bind(user_id)
    .bind(property_id)
    .fetch_one(pool)
    .await
    .context("Не удалось проверить избранное")?;

    Ok(exists)
}

pub async fn get_favorites(
    pool: &PgPool,
    user_id: Uuid,
) -> Result<Vec<Property>> {
    sqlx::query_as::<_, Property>(
        r#"
        SELECT
            p.id,
            p.title,
            p.description,
            p.city,
            p.district,
            p.price,
            p.rooms,
            p.area,
            p.photo_url,
            p.is_active,
            p.created_at
        FROM properties p
        INNER JOIN favorites f
            ON f.property_id = p.id
        WHERE
            f.user_id = $1
            AND p.is_active = TRUE
        ORDER BY f.created_at DESC
        "#,
    )
    .bind(user_id)
    .fetch_all(pool)
    .await
    .context("Не удалось получить избранные объекты")
}

pub async fn create_viewing_request(
    pool: &PgPool,
    user_id: Uuid,
    property_id: Uuid,
    comment: Option<&str>,
) -> Result<ViewingRequest> {
    sqlx::query_as::<_, ViewingRequest>(
        r#"
        INSERT INTO viewing_requests (
            user_id,
            property_id,
            status,
            comment
        )
        VALUES ($1, $2, $3, $4)
        RETURNING
            id,
            user_id,
            property_id,
            status,
            comment,
            created_at
        "#,
    )
    .bind(user_id)
    .bind(property_id)
    .bind(RequestStatus::New.to_string())
    .bind(comment)
    .fetch_one(pool)
    .await
    .context("Не удалось создать заявку на просмотр")
}

pub async fn get_requests(
