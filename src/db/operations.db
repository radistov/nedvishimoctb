use anyhow::{Context, Result};
use chrono::{DateTime, Utc};
use sqlx::PgPool;
use uuid::Uuid;

use crate::models::{
    Favorite, Property, RequestStatus, User, UserProfile, ViewingRequest,
};

pub async fn get_user_by_telegram_id(
    pool: &PgPool,
    telegram_id: i64,
) -> Result<Option<User>> {
    sqlx::query_as::<_, User>(
        r#"
        SELECT
            id,
            telegram_id,
            username,
            first_name,
            last_name,
            phone,
            created_at
        FROM users
        WHERE telegram_id = $1
        "#,
    )
    .bind(telegram_id)
    .fetch_optional(pool)
    .await
    .context("Не удалось получить пользователя")
}

pub async fn create_user(
    pool: &PgPool,
    telegram_id: i64,
    username: Option<&str>,
    first_name: &str,
    last_name: Option<&str>,
) -> Result<User> {
    sqlx::query_as::<_, User>(
        r#"
        INSERT INTO users (
            telegram_id,
            username,
            first_name,
            last_name
        )
        VALUES ($1, $2, $3, $4)
        RETURNING
            id,
            telegram_id,
            username,
            first_name,
            last_name,
            phone,
            created_at
        "#,
    )
    .bind(telegram_id)
    .bind(username)
    .bind(first_name)
    .bind(last_name)
    .fetch_one(pool)
    .await
    .context("Не удалось создать пользователя")
}

pub async fn update_user_phone(
    pool: &PgPool,
    user_id: Uuid,
    phone: &str,
) -> Result<()> {
    sqlx::query(
        r#"
        UPDATE users
        SET phone = $1
        WHERE id = $2
        "#,
    )
    .bind(phone)
    .bind(user_id)
    .execute(pool)
    .await
    .context("Не удалось сохранить номер телефона")?;

    Ok(())
}

