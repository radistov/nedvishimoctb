pub async fn create_property(
    pool: &PgPool,
    title: &str,
    description: &str,
    city: &str,
    district: &str,
    price: i64,
    rooms: i32,
    area: f32,
    photo_url: Option<&str>,
    is_active: bool,
) -> Result<Property> {
    sqlx::query_as::<_, Property>(
        r#"
        INSERT INTO properties (
            title,
            description,
            city,
            district,
            price,
            rooms,
            area,
            photo_url,
            is_active
        )
        VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
        RETURNING
            id,
            title,
            description,
            city,
            district,
            price,
            rooms,
            area,
            photo_url,
            is_active,
            created_at
        "#,
    )
    .bind(title)
    .bind(description)
    .bind(city)
    .bind(district)
    .bind(price)
    .bind(rooms)
    .bind(area)
    .bind(photo_url)
    .bind(is_active)
    .fetch_one(pool)
    .await
    .context("Не удалось создать объект недвижимости")
}

pub async fn update_property(
    pool: &PgPool,
    property_id: Uuid,
    title: &str,
    description: &str,
    city: &str,
    district: &str,
    price: i64,
    rooms: i32,
    area: f32,
    photo_url: Option<&str>,
    is_active: bool,
) -> Result<Option<Property>> {
    sqlx::query_as::<_, Property>(
        r#"
        UPDATE properties
        SET
            title = $1,
            description = $2,
            city = $3,
            district = $4,
            price = $5,
            rooms = $6,
            area = $7,
            photo_url = $8,
            is_active = $9
        WHERE id = $10
        RETURNING
            id,
            title,
            description,
            city,
            district,
            price,
            rooms,
            area,
            photo_url,
            is_active,
            created_at
        "#,
    )
    .bind(title)
    .bind(description)
    .bind(city)
    .bind(district)
    .bind(price)
    .bind(rooms)
    .bind(area)
    .bind(photo_url)
    .bind(is_active)
    .bind(property_id)
    .fetch_optional(pool)
    .await
    .context("Не удалось обновить объект недвижимости")
}

pub async fn delete_property(
    pool: &PgPool,
    property_id: Uuid,
) -> Result<bool> {
    let result = sqlx::query(
        r#"
        DELETE FROM properties
        WHERE id = $1
        "#,
    )
    .bind(property_id)
    .execute(pool)
    .await
    .context("Не удалось удалить объект недвижимости")?;

    Ok(result.rows_affected() > 0)
}

pub async fn list_properties(
    pool: &PgPool,
    include_inactive: bool,
) -> Result<Vec<Property>> {
    let properties = if include_inactive {
        sqlx::query_as::<_, Property>(
            r#"
            SELECT
                id,
                title,
                description,
                city,
                district,
                price,
                rooms,
                area,
                photo_url,
                is_active,
                created_at
            FROM properties
            ORDER BY created_at DESC
            "#,
        )
        .fetch_all(pool)
        .await
    } else {
        sqlx::query_as::<_, Property>(
            r#"
            SELECT
                id,
                title,
                description,
                city,
                district,
                price,
                rooms,
                area,
                photo_url,
                is_active,
                created_at
            FROM properties
            WHERE is_active = TRUE
            ORDER BY created_at DESC
            "#,
        )
        .fetch_all(pool)
        .await
    };

    properties.context("Не удалось получить список объектов")
}

pub async fn get_all_requests(
    pool: &PgPool,
) -> Result<Vec<(ViewingRequest, User, Property)>> {
    sqlx::query_as::<_, (ViewingRequest, User, Property)>(
        r#"
        SELECT
            vr.id,
            vr.user_id,
            vr.property_id,
            vr.status,
            vr.comment,
            vr.created_at,

            u.id,
            u.telegram_id,
            u.username,
            u.first_name,
            u.last_name,
            u.phone,
            u.created_at,

            p.id,
            p.title,
            p.description,
            p.city,
            p.district,
            p.price,
            p.rooms,
            p.area,
            p.photo_url,
            p.is_active,
            p.created_at
        FROM viewing_requests vr
        INNER JOIN users u
            ON u.id = vr.user_id
        INNER JOIN properties p
            ON p.id = vr.property_id
        ORDER BY vr.created_at DESC
        "#,
    )
    .fetch_all(pool)
    .await
    .context("Не удалось получить список заявок")
}

pub async fn get_request(
    pool: &PgPool,
    request_id: Uuid,
) -> Result<Option<(ViewingRequest, User, Property)>> {
    sqlx::query_as::<_, (ViewingRequest, User, Property)>(
        r#"
        SELECT
            vr.id,
            vr.user_id,
            vr.property_id,
            vr.status,
            vr.comment,
            vr.created_at,

            u.id,
            u.telegram_id,
            u.username,
            u.first_name,
            u.last_name,
            u.phone,
            u.created_at,

            p.id,
            p.title,
            p.description,
            p.city,
            p.district,
            p.price,
            p.rooms,
            p.area,
            p.photo_url,
            p.is_active,
            p.created_at
        FROM viewing_requests vr
        INNER JOIN users u
            ON u.id = vr.user_id
        INNER JOIN properties p
            ON p.id = vr.property_id
        WHERE vr.id = $1
        "#,
    )
    .bind(request_id)
    .fetch_optional(pool)
    .await
    .context("Не удалось получить заявку")
}

