pub async fn update_profile(
    pool: &PgPool,
    user_id: Uuid,
    city: Option<&str>,
    district: Option<&str>,
    budget: Option<i64>,
    rooms: Option<i32>,
    additional_requirements: Option<&str>,
) -> Result<()> {
    sqlx::query(
        r#"
        UPDATE user_profiles
        SET
            city = $1,
            district = $2,
            budget = $3,
            rooms = $4,
            additional_requirements = $5
        WHERE user_id = $6
        "#,
    )
    .bind(city)
    .bind(district)
    .bind(budget)
    .bind(rooms)
    .bind(additional_requirements)
    .bind(user_id)
    .execute(pool)
    .await
    .context("Не удалось обновить профиль")?;

    Ok(())
}

pub async fn search_properties(
    pool: &PgPool,
    city: &str,
    district: &str,
    budget: i64,
    rooms: i32,
) -> Result<Vec<Property>> {
    sqlx::query_as::<_, Property>(
        r#"
        SELECT
            id,
            title,
            description,
            city,
            district,
            price,
            rooms,
            area,
            photo_url,
            is_active,
            created_at
        FROM properties
        WHERE
            is_active = TRUE
            AND city = $1
            AND district = $2
            AND price <= $3
            AND rooms = $4
        ORDER BY price ASC, created_at DESC
        "#,
    )
    .bind(city)
    .bind(district)
    .bind(budget)
    .bind(rooms)
    .fetch_all(pool)
    .await
    .context("Не удалось выполнить поиск недвижимости")
}

