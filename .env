# .env
# НИКОГДА не коммить этот файл в Git.
# Сюда подставляются реальные секреты.

# Telegram Bot API
TELEGRAM_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE

# PostgreSQL
# Используй отдельного пользователя БД с минимальными правами.
DATABASE_URL=postgres://real_estate_bot:CHANGE_THIS_PASSWORD@127.0.0.1:5432/real_estate_bot

# Telegram ID администратора
ADMIN_CHAT_ID=PASTE_YOUR_TELEGRAM_USER_ID_HERE

# Секрет для доступа к HTTP API админки.
# Сгенерируй длинную случайную строку, например:
# openssl rand -hex 32
ADMIN_API_TOKEN=PASTE_A_LONG_RANDOM_SECRET_HERE

# HTTP API
# Для локального сервера лучше слушать только localhost.
HOST=127.0.0.1
PORT=8080

# Логи
RUST_LOG=info

# ВАЖНО:
# 1. Не отправляй .env другим людям.
# 2. Не вставляй реальные токены/пароли в GitHub.
# 3. Если TELEGRAM_TOKEN или ADMIN_API_TOKEN утёк — немедленно замени его.
# 4. Для PostgreSQL используй отдельную БД и отдельного пользователя приложения.